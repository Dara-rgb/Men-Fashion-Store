{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/assets/(.*)",
            "dist": "/public/assets/$1"
        },
        {
            "src": "/((?!api/).*\\.(js|css|png|jpg|svg|ico))",
            "dist": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dist": "api/index.php"
        }
    ]
}